{
  "name": "@ykstormsorg/quickdraw",
  "version": "1.0.4",
  "description": "Benchmark LLM streaming — TTFT, TPS, p50/p95/p99, cost ceiling, and regression diffing across OpenAI and Anthropic.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "quickdraw": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "bench": "ts-node bin/cli.ts bench",
    "bench:dry": "cross-env DRY_RUN=true ts-node bin/cli.ts bench --providers openai --runs 1",
    "diff": "ts-node bin/cli.ts diff",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src bin --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "benchmark",
    "streaming",
    "ttft",
    "tps",
    "openai",
    "anthropic",
    "ai",
    "performance"
  ],
  "homepage": "https://github.com/ykstorm/quickdraw",
  "repository": "github:ykstorm/quickdraw",
  "author": "Lakshyaraj Singh Rao <raolakshyaraj@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^7.0.3",
    "eslint": "^10.5.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
