{
  "name": "@ykstorm/quickdraw",
  "version": "1.0.0",
  "description": "Benchmark LLM streaming. TTFT, TPS, cost ceiling, nightly dashboard.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "quickdraw": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src/index.ts bin/cli.ts --format cjs,esm --clean",
    "bench": "ts-node bin/run.ts",
    "bench:dry": "DRY_RUN=true ts-node bin/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "dashboard": "tsx bin/dashboard.ts"
  },
  "keywords": [
    "llm",
    "benchmark",
    "streaming",
    "ttft",
    "tps",
    "openai",
    "anthropic",
    "ai",
    "performance"
  ],
  "homepage": "https://quickdraw.lakshyaraj.dev",
  "repository": "github:ykstorm/quickdraw",
  "author": "Lakshyaraj Singh Rao <raolakshyaraj@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^1.6.1",
    "commander": "^14.0.3",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.7"
  }
}
